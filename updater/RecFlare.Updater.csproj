<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>RecFlare.Updater</AssemblyName>
    <Version>3.0.0</Version>
    <StartupObject>Recovered.Worker</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0051;SYSLIB0003;CS0672;CS0618;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/managed/**/*.cs" Exclude="../src/managed/**/Properties/AssemblyInfo.cs" />
    <Compile Include="Worker.cs" />
    <Compile Include="ManagedDelta.cs" />
    <PackageReference Include="Autofac" Version="4.9.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Standart.Hash.xxHash" Version="1.0.6" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Sentry" Version="1.1.2" />
  </ItemGroup>
</Project>
